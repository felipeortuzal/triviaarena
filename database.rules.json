{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || (data.exists() && data.child('host').val() === auth.uid))",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','nick']) && newData.child('uid').val() === auth.uid && newData.child('nick').isString() && newData.child('nick').val().length <= 28"
          }
        },
        "guesses": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($room).child('members').child(auth.uid).exists() && !root.child('rooms').child($room).child('round').child('revealed').val()",
              ".validate": "newData.isString() && newData.val().length <= 120"
            }
          }
        }
      }
    }
  }
}
